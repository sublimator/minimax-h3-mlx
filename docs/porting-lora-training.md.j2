### 6.2 The builder

{{ code(BD, function='PH3ImagePrepareConditionLatentsStep.__call__', root=DM) }}
{{ code(BD, function='PH3ImagePrepareLatentsStep.__call__', root=DM) }}
{{ code(BD, lines=(939, 944), root=DM) }}

{{ code('src/h3mlx/train.py', struct='Example') }}
